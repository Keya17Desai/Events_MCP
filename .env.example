# Events MCP — Environment Variables
# Copy this file to ".env" and fill in your real values.
# .env is gitignored; .env.example is committed.

# Ticketmaster Discovery API key (consumer key from https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here

# Resend transactional email (Phase 5.5 — optional)
# Get a key at https://resend.com — free tier is 100/day.
# Leave blank to disable booking-confirmation emails (the booking flow
# still works end-to-end, the post-booking email is just skipped).
RESEND_API_KEY=

# From address for booking emails. Default uses Resend's pre-verified
# sandbox sender so you don't need to set up DNS for a domain. Once you
# verify a custom domain in Resend, override this with e.g.
#   RESEND_FROM="Events MCP <bookings@your-domain.com>"
RESEND_FROM="Events MCP <onboarding@resend.dev>"
